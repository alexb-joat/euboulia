{
  "name": "euboulia",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that suggests the best-value LLM for the prompt you are typing, on any chat site.",
  "author": "Alex <beyondpeaksolstice@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs --target all",
    "build:dev": "node scripts/build.mjs --target all --dev",
    "watch": "node scripts/build.mjs --target all --dev --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs --target chrome --dev && playwright test",
    "test:ff": "node scripts/build.mjs --target firefox --dev && node tests/e2e/firefox.mjs",
    "lint:ff": "web-ext lint --source-dir dist/firefox",
    "run:ff": "node scripts/run-firefox.mjs",
    "package": "node scripts/package.mjs",
    "catalog:build": "node scripts/build-catalog.mjs",
    "catalog:validate": "node scripts/validate-catalog.mjs",
    "fixture": "node scripts/snapshot-fixture.mjs",
    "screenshots": "node scripts/build.mjs --target chrome --dev && node scripts/screenshots.mjs",
    "catalog:publish": "node scripts/validate-catalog.mjs && node scripts/publish-catalog.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "selenium-webdriver": "4.51.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "web-ext": "10.7.0"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  }
}
