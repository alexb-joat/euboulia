{
  "manifest_version": 3,
  "name": "Euboulia",
  "version": "0.1.0",
  "description": "Suggests the best-value model for the prompt you are typing, on any LLM chat site. Nothing you type leaves the browser.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Euboulia settings"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
